# Copy this file to keystore.properties (gitignored) once you've generated
# your real release keystore. Until keystore.properties exists, release
# builds are unsigned — fine for local testing, not for Play Store upload.
#
# Generate a release keystore (do this once, keep the .jks and these
# passwords somewhere durable — losing them means you can never update
# the app on Play Store under the same listing again):
#
#   keytool -genkeypair -v \
#     -keystore resq-release.jks \
#     -alias resq \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then fill in the real values below and keep the .jks file out of git
# (already covered by .gitignore's *.jks / *.keystore rules).

storeFile=../resq-release.jks
storePassword=CHANGE_ME
keyAlias=resq
keyPassword=CHANGE_ME
