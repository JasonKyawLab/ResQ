<?xml version="1.0" encoding="utf-8"?>
<!--
  Same SOS morse mark as ic_launcher_foreground.xml, but cropped tight
  to the mark's own bounding box instead of padded for the adaptive-icon
  safe zone. The launcher icon needs that padding so OS masking never
  clips it; an in-app Image (AppMark) displayed flat has no masking to
  worry about, so that same padding just reads as a big empty gap
  between the mark and whatever text sits next to it. Coordinates here
  are the launcher version's, shifted by (-32, -35) into this tighter
  44x38 viewport — same mark, no wasted canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="44dp"
    android:height="38dp"
    android:viewportWidth="44"
    android:viewportHeight="38">
