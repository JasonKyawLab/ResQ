<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ResQ" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/oled_black</item>
        <item name="android:statusBarColor">@color/oled_black</item>
        <item name="android:navigationBarColor">@color/oled_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ResQ.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/oled_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ResQ</item>
    </style>
</resources>
